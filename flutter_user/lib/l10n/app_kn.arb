  "doshExplain": "ನನ್ನ ದೋಷಗಳನ್ನು ವಿವರಿಸಿ",
  "doshExplainSubtitle": "ನಿಮ್ಮ ದೋಷಗಳ ಬಗ್ಗೆ ಶಾಂತ, ಪ್ರಾಯೋಗಿಕ ನೋಟ",
  "doshExplainReassure": "ದೋಷಗಳು ಸಾಮಾನ್ಯ — ಬಹುತೇಕ ಪ್ರತಿ ಜಾತಕದಲ್ಲಿಯೂ ಕೆಲವು ಇರುತ್ತವೆ. ಇವು ಪ್ರವೃತ್ತಿಗಳನ್ನು ವಿವರಿಸುತ್ತವೆ, ನಿಶ್ಚಿತ ಹಣೆಬರಹವನ್ನಲ್ಲ. ಅರಿವು, ಉತ್ತಮ ನಡವಳಿಕೆ ಮತ್ತು ಸರಳ ಪರಿಹಾರಗಳು ಅವುಗಳ ಪ್ರಾಯೋಗಿಕ ಪರಿಣಾಮವನ್ನು ಕಡಿಮೆ ಮಾಡುತ್ತವೆ, ಆದ್ದರಿಂದ ಚಿಂತೆ ಪಡುವ ಅಗತ್ಯವಿಲ್ಲ.",
  "doshAiGeneric": "ಈ ದೋಷವು ನಿಮ್ಮ ಜಾತಕದಲ್ಲಿ ಒಂದು ಪ್ರವೃತ್ತಿಯನ್ನು ವಿವರಿಸುತ್ತದೆ. ಇದರ ಪ್ರಾಯೋಗಿಕ ಪರಿಣಾಮ ಸಾಮಾನ್ಯವಾಗಿ ಸೌಮ್ಯವಾಗಿರುತ್ತದೆ ಮತ್ತು ಅರಿವು ಹಾಗೂ ಸರಳ ಪರಿಹಾರಗಳಿಂದ ಸಮತೋಲನಗೊಳಿಸಬಹುದು.",
  "doshHeroSummary": "ನಿಮ್ಮ ಜಾತಕದಲ್ಲಿ ಪರಿಶೀಲಿಸಿದ {total}ರಲ್ಲಿ {active} ಸಕ್ರಿಯ ದೋಷಗಳು ಕಂಡುಬಂದಿವೆ. ಹೆಚ್ಚಿನವು ಸೌಮ್ಯವಾಗಿದ್ದು, ಕೆಲವು ಮಾತ್ರ ಗಮನ ಬಯಸುತ್ತವೆ. ತಿಳುವಳಿಕೆ ಮತ್ತು ಸರಳ ಪರಿಹಾರಗಳಿಂದ ಇವುಗಳ ಪ್ರಾಯೋಗಿಕ ಪರಿಣಾಮವನ್ನು ಕಡಿಮೆ ಮಾಡಬಹುದು.",
  "doshAiLine": "ಈ ದೋಷವು ಮುಖ್ಯವಾಗಿ {areas} ಅನ್ನು ಪ್ರಭಾವಿಸುತ್ತದೆ. {planet} ದಶಾ ಅವಧಿಯಲ್ಲಿ ಇದರ ಪರಿಣಾಮ ಹೆಚ್ಚು ಅನುಭವಕ್ಕೆ ಬರಬಹುದು, ಮತ್ತು ಪರಿಹಾರಗಳು ಅದನ್ನು ಸಮತೋಲನಗೊಳಿಸಲು ಸಹಾಯ ಮಾಡುತ್ತವೆ.",
  "doshTimelineLine": "ಇದರ ಪರಿಣಾಮ {planet}ನ ಮಹಾದಶಾ ಮತ್ತು ಅಂತರ್ದಶಾ ಸಮಯದಲ್ಲಿ, ಮತ್ತು ಗೋಚಾರದಲ್ಲಿ {planet} ಸಕ್ರಿಯವಾದಾಗ ಹೆಚ್ಚು ಅನುಭವಕ್ಕೆ ಬರುತ್ತದೆ.",
