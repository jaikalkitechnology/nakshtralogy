  "aspInfoTitle": "ದೃಷ್ಟಿ (Drishti) ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವುದು",
  "aspQGraha": "ಗ್ರಹ ದೃಷ್ಟಿ ಎಂದರೇನು?",
  "aspQRashi": "ರಾಶಿ ದೃಷ್ಟಿ ಎಂದರೇನು?",
  "aspQDiff": "ಎರಡರ ನಡುವಿನ ವ್ಯತ್ಯಾಸ",
  "aspQPredict": "ದೃಷ್ಟಿಗಳು ಭವಿಷ್ಯವಾಣಿಯ ಮೇಲೆ ಹೇಗೆ ಪರಿಣಾಮ ಬೀರುತ್ತವೆ",
  "aspGrahaBody": "ಗ್ರಹ ದೃಷ್ಟಿ ಎಂದರೆ ಒಂದು ಗ್ರಹ ತನ್ನ ಸ್ಥಾನದಿಂದ ಬೀರುವ ದೃಷ್ಟಿ. ಪ್ರತಿಯೊಂದು ಗ್ರಹವು ತನ್ನ ಸ್ಥಳದಿಂದ 7ನೇ ಭಾವ/ಗ್ರಹದ ಮೇಲೆ ಸಂಪೂರ್ಣ ದೃಷ್ಟಿ ಬೀರುತ್ತದೆ (ನೇರ, ಮುಖಾಮುಖಿ ಪ್ರಭಾವ). ಇದಲ್ಲದೆ, ಮಂಗಳ 4ನೇ ಮತ್ತು 8ನೇ ಸ್ಥಾನದ ಮೇಲೆ, ಗುರು 5ನೇ ಮತ್ತು 9ನೇ ಸ್ಥಾನದ ಮೇಲೆ, ಮತ್ತು ಶನಿ 3ನೇ ಮತ್ತು 10ನೇ ಸ್ಥಾನದ ಮೇಲೆ ದೃಷ್ಟಿ ಬೀರುತ್ತಾರೆ. ರಾಹು ಮತ್ತು ಕೇತುಗೆ ಸಾಮಾನ್ಯವಾಗಿ 5, 7 ಮತ್ತು 9ನೇ ದೃಷ್ಟಿಗಳನ್ನು ನೀಡಲಾಗುತ್ತದೆ. ಒಂದು ಗ್ರಹದ ದೃಷ್ಟಿ ಅದು ಬೀಳುವ ಗ್ರಹ ಅಥವಾ ಭಾವಕ್ಕೆ ತನ್ನ ಸ್ವಭಾವದ ಬಣ್ಣವನ್ನು ನೀಡುತ್ತದೆ.",
  "aspRashiBody": "ರಾಶಿ ದೃಷ್ಟಿ ಜೈಮಿನಿ ಜ್ಯೋತಿಷ್ಯದ ರಾಶಿಯಿಂದ-ರಾಶಿಗೆ ಇರುವ ದೃಷ್ಟಿಯಾಗಿದ್ದು, ಅಲ್ಲಿ ಯಾವ ಗ್ರಹಗಳಿವೆ ಎಂಬುದರ ಮೇಲೆ ಅವಲಂಬಿತವಾಗಿಲ್ಲ. ಚರ ರಾಶಿಗಳು ಸ್ಥಿರ ರಾಶಿಗಳ ಮೇಲೆ ದೃಷ್ಟಿ ಬೀರುತ್ತವೆ (ಪಕ್ಕದ್ದನ್ನು ಹೊರತುಪಡಿಸಿ), ಸ್ಥಿರ ರಾಶಿಗಳು ಚರ ರಾಶಿಗಳ ಮೇಲೆ ದೃಷ್ಟಿ ಬೀರುತ್ತವೆ (ಪಕ್ಕದ್ದನ್ನು ಹೊರತುಪಡಿಸಿ), ಮತ್ತು ದ್ವಿಸ್ವಭಾವ ರಾಶಿಗಳು ಇತರ ದ್ವಿಸ್ವಭಾವ ರಾಶಿಗಳ ಮೇಲೆ ದೃಷ್ಟಿ ಬೀರುತ್ತವೆ. ಇದನ್ನು ಮುಖ್ಯವಾಗಿ ಜೈಮಿನಿ ಭವಿಷ್ಯವಾಣಿಯಲ್ಲಿ ಮತ್ತು ಭಾವಗಳ ನಡುವಿನ ಸಂಬಂಧವನ್ನು ನಿರ್ಣಯಿಸಲು ಬಳಸಲಾಗುತ್ತದೆ.",
  "aspDiffBody": "ಗ್ರಹ ದೃಷ್ಟಿಯನ್ನು ಒಂದು ಗ್ರಹ ಬೀರುತ್ತದೆ ಮತ್ತು ಅದು ಆ ಗ್ರಹ ಎಲ್ಲಿ ಇದೆ ಎಂಬುದರ ಮೇಲೆ ಅವಲಂಬಿತವಾಗಿದೆ. ರಾಶಿ ದೃಷ್ಟಿ ರಾಶಿಗೇ ಸೇರಿದ್ದು ಮತ್ತು ಅದರಲ್ಲಿ ಏನೇ ಇರಿಸಿದ್ದರೂ ಅದಕ್ಕೆ ಅನ್ವಯಿಸುತ್ತದೆ. ಗ್ರಹ ದೃಷ್ಟಿ ದಿಕ್ಕಾತ್ಮಕವಾಗಿದೆ (ಗ್ರಹ A ಗ್ರಹ Bಯನ್ನು ನೋಡುತ್ತದೆ), ಆದರೆ ರಾಶಿ ದೃಷ್ಟಿ ಸಾಮಾನ್ಯವಾಗಿ ರಾಶಿಗಳ ನಡುವೆ ಪರಸ್ಪರವಾಗಿರುತ್ತದೆ. ಎರಡೂ ಒಂದೇ ಗುರಿಯನ್ನು ಸೂಚಿಸಿದಾಗ, ಪ್ರಭಾವ ವಿಶೇಷವಾಗಿ ಪ್ರಬಲವಾಗಿರುತ್ತದೆ.",
  "aspPredictBody": "ಒಂದು ದೃಷ್ಟಿ ಒಂದು ಗ್ರಹ ತನ್ನ ಸ್ವಂತ ಭಾವವನ್ನು ಮೀರಿ ತನ್ನ ಪ್ರಭಾವವನ್ನು ಎಲ್ಲಿ ವಿಸ್ತರಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ತೋರಿಸುತ್ತದೆ. ಒಂದು ಶುಭ ದೃಷ್ಟಿ (ಗುರು, ಶುಕ್ರ, ಉತ್ತಮ ಸ್ಥಾನದಲ್ಲಿರುವ ಚಂದ್ರ/ಬುಧ) ಗುರಿಯನ್ನು ಬೆಂಬಲಿಸಿ ರಕ್ಷಿಸುತ್ತದೆ; ಒಂದು ಅಶುಭ ದೃಷ್ಟಿ (ಶನಿ, ಮಂಗಳ, ಸೂರ್ಯ, ರಾಹು, ಕೇತು) ಅದರ ಮೇಲೆ ಒತ್ತಡ, ವಿಳಂಬ ಅಥವಾ ಸವಾಲನ್ನು ಉಂಟುಮಾಡಬಹುದು. ಯಾವ ಗ್ರಹಗಳು ಒಂದು ಭಾವ ಅಥವಾ ಗ್ರಹದ ಮೇಲೆ ದೃಷ್ಟಿ ಬೀರುತ್ತವೆ ಎಂಬುದನ್ನು ಓದುವುದರಿಂದ ಫಲಿತಾಂಶಗಳು ಏಕೆ ಹಾಗೆ ಕಾಣುತ್ತವೆ ಎಂಬುದನ್ನು ವಿವರಿಸುತ್ತದೆ.",
