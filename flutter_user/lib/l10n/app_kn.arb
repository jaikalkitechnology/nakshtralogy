  "plHouse4": "ಮನೆ, ತಾಯಿ, ಸೌಕರ್ಯ, ಆಸ್ತಿ ಮತ್ತು ಆಂತರಿಕ ಶಾಂತಿ",
  "plHouse5": "ಮಕ್ಕಳು, ಸೃಜನಶೀಲತೆ, ಬುದ್ಧಿ, ಪ್ರೀತಿ ಮತ್ತು ಪೂರ್ವ ಪುಣ್ಯ",
  "plHouse6": "ಆರೋಗ್ಯ, ಶತ್ರುಗಳು, ಸಾಲಗಳು, ಸೇವೆ ಮತ್ತು ದೈನಂದಿನ ಕೆಲಸ",
  "plHouse7": "ವಿವಾಹ, ಪಾಲುದಾರಿಕೆ ಮತ್ತು ವ್ಯಾಪಾರ ಸಂಬಂಧಗಳು",
  "plHouse8": "ಆಯುಷ್ಯ, ಪರಿವರ್ತನೆ, ರಹಸ್ಯಗಳು ಮತ್ತು ಪಿತ್ರಾರ್ಜಿತ ಆಸ್ತಿ",
  "plHouse9": "ಅದೃಷ್ಟ, ಧರ್ಮ, ಉನ್ನತ ವಿದ್ಯೆ, ಗುರು ಮತ್ತು ತಂದೆ",
  "plHouse10": "ವೃತ್ತಿ, ಸ್ಥಾನಮಾನ, ಅಧಿಕಾರ ಮತ್ತು ಸಾರ್ವಜನಿಕ ಕರ್ಮ",
  "plHouse11": "ಲಾಭಗಳು, ಆದಾಯ, ಸ್ನೇಹಿತರು, ಸಂಪರ್ಕಜಾಲ ಮತ್ತು ಈಡೇರಿದ ಆಸೆಗಳು",
  "plHouse12": "ನಷ್ಟ, ಖರ್ಚು, ವಿದೇಶ, ಆಧ್ಯಾತ್ಮಿಕತೆ ಮತ್ತು ಮೋಕ್ಷ",
