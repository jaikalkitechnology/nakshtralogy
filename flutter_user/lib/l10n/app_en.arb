  "aspTraitMoon": "emotional depth, comfort and intuition",
  "aspTraitMars": "energy, courage and drive",
  "aspTraitMercury": "communication, intellect and adaptability",
  "aspTraitJupiter": "wisdom, growth and good fortune",
  "aspTraitVenus": "love, harmony and comforts",
  "aspTraitSaturn": "discipline, responsibility and patient, sometimes delayed, success",
  "aspTraitRahu": "ambition, intensity and unconventional turns",
  "aspTraitKetu": "detachment, spirituality and sudden change",
