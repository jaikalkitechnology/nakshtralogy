# systemd unit for the Hindustani Jyotish FastAPI backend (gunicorn + uvicorn).
# Install: /etc/systemd/system/hindustani-jyotish.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now hindustani-jyotish
# Logs: journalctl -u hindustani-jyotish -f

[Unit]
Description=Hindustani Jyotish FastAPI backend (gunicorn/uvicorn)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=notify
User=hj
Group=hj
WorkingDirectory=/opt/hindustani_jyotish/app/hindustani_jyotish_backen_fastapi

# Secrets come from the .env file (see PRODUCTION.md). Keep it 0600, owned by hj.
EnvironmentFile=/opt/hindustani_jyotish/app/hindustani_jyotish_backen_fastapi/.env

# Single worker by default — see gunicorn_conf.py for why. Override the worker
# count via GUNICORN_WORKERS in the .env ONLY after the Redis fan-out lands.
ExecStart=/opt/hindustani_jyotish/app/hindustani_jyotish_backen_fastapi/.venv/bin/gunicorn \
    app.main:app \
    -c /opt/hindustani_jyotish/app/hindustani_jyotish_backen_fastapi/deploy/gunicorn_conf.py

ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=30

# ── Hardening ────────────────────────────────────────────────────────────────
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# Allow writing generated media (PDFs/avatars/KYC docs) under the app tree if
# MEDIA_ROOT is inside it; otherwise point MEDIA_ROOT at a dedicated dir and
# add it here. MEDIA_ROOT now defaults to "static" (see app/core/config.py);
# the old "media" path is kept for setups still running the previous layout.
ReadWritePaths=/opt/hindustani_jyotish/app/hindustani_jyotish_backen_fastapi/static
ReadWritePaths=/opt/hindustani_jyotish/app/hindustani_jyotish_backen_fastapi/media

[Install]
WantedBy=multi-user.target
