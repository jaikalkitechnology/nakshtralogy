# ── Hindustani Jyotish · Backend environment ──────────────────────────
# Copy to `.env` and fill in. Never commit the real .env.

# App
APP_NAME="Hindustani Jyotish API"
ENVIRONMENT=local            # local | dev | staging | prod
DEBUG=true
API_V1_PREFIX=/v1

# CORS (comma-separated origins; "*" for all in local)
CORS_ORIGINS=*

# ── MySQL ─────────────────────────────────────────────────────────────
# Async SQLAlchemy URL. Driver: aiomysql. The value below is a NON-PRODUCTION
# localhost placeholder — replace user/password/host for real deployments and
# never commit real credentials.
DATABASE_URL=mysql+aiomysql://hj_user:hj_password@localhost:3306/hindustani_jyotish

# ── JWT ───────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# The app warns loudly at startup if this is left at the default outside `local`.
JWT_SECRET=change-me-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google Sign-In ────────────────────────────────────────────────────
# Accepted audiences for the Google ID token (comma-separated client IDs).
# Defaults (baked into config) are the two public app OAuth client IDs:
#   user : 892936615659-cb85ph8d209u9g94og1usprqffigns22.apps.googleusercontent.com
#   astro: 892936615659-ov54962d8n0prsugt2vav7umfmpfuom5.apps.googleusercontent.com
# Set here only to override.
GOOGLE_CLIENT_IDS=

# ── OTP / SMS (MSG91) ─────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
# Per-identifier (mobile or email) hourly OTP request cap. Enabled by default
# in code (OTP_RATE_LIMIT_ENABLED defaults to true even if unset here). Set
# to false below for friction-free repeated login/logout during local dev —
# leave enabled everywhere else to prevent SMS/email bombing.
OTP_RATE_LIMIT_ENABLED=true
OTP_RATE_PER_HOUR=5
OTP_RATE_PER_DAY_PER_IP=30
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# When true, OTPs are not sent over SMS but returned/logged for local dev.
OTP_DEV_MODE=true

# ── Redis (optional in Phase 1) ───────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Agora (Phase 2 · real-time A/V) ───────────────────────────────────
# Leave blank in local/dev — a placeholder RTC token is returned instead.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRE_SECONDS=3600
COMMISSION_RATE=0.25
MIN_PRECALL_MINUTES=5

# ── Kundli & insights (Phase 3) ───────────────────────────────────────
# Nakshatralogy — external Vedic-astrology provider for the paid cosmic
# services (detailed kundli, planet positions, daily forecast, kundli milan).
# Copy the Bearer key below into your deployment's .env only — never into
# code. Leave empty to use the internal stub engine (dev/CI-safe fallback).
#   NAKSHATRALOGY_API_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  (real key: server .env only — rotate the one committed in credentials/cosmic_services.txt)
NAKSHATRALOGY_API_KEY=
NAKSHATRALOGY_BASE_URL=https://api.nakshatralogy.com
NAKSHATRALOGY_TIMEOUT_SECONDS=45
DEFAULT_AYANAMSA=lahiri        # lahiri | raman | kp
MEDIA_ROOT=media
MEDIA_BASE_URL=/media

# ── Admin seed (Phase 4) ──────────────────────────────────────────────
# When both set, `python -m app.core.dev_init` creates this admin.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# One-time token to authorise POST /admin/create-admin AFTER the first admin
# exists (sent as the X-Admin-Setup-Token header). Empty → extra admins refused.
ADMIN_SETUP_TOKEN=

# ── Payments · Razorpay (Phase 6) ─────────────────────────────────────
# Leave blank in local/dev — orders & signatures are simulated (PAYMENTS_DEV_MODE).
# These are the env fallback; admin-managed credentials in the `razorpay_settings`
# table (admin console) take precedence when an active row exists.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_DEV_MODE=true
RECHARGE_MIN=10
RECHARGE_MAX=50000
BIOMETRIC_RECHARGE_THRESHOLD=1000
MIN_WITHDRAWAL=100
PAYOUT_AUTO_PROCESS=true

# ── Observability (optional) ──────────────────────────────────────────
# Sentry DSN. Leave blank to disable (init becomes a no-op in dev/CI).
SENTRY_DSN=
