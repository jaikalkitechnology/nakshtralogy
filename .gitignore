# ── Python ────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
venv/
.env

# ── Firebase Service Account Keys ─────────────────────────────
# credentials/ dir has placeholder files — replace with real keys on server
# If you put real keys, uncomment these lines:
# credentials/firebase-user-sa.json
# credentials/firebase-astro-sa.json

# ── Flutter google-services (contains API keys) ──────────────
flutter_user/android/app/google-services.json
flutter_astro/android/app/google-services.json
flutter_user/ios/Runner/GoogleService-Info.plist
flutter_astro/ios/Runner/GoogleService-Info.plist

# ── Flutter build artifacts ───────────────────────────────────
**/build/
**/.dart_tool/
**/.flutter-plugins
**/.flutter-plugins-dependencies
**/.packages

# ── IDE ───────────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── React build ──────────────────────────────────────────────
react_admin/node_modules/
react_admin/dist/

# ── OS ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# engineSpecialistUI: intermediate per-locale translation outputs (applied to
# ARBs via translate_apply.py, then discarded). The *_source.json queue stays tracked.
.claude/tasks/pending_translations/*_tr_*.json
