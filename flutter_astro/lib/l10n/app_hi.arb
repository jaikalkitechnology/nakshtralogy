  "avQWhatIsBav": "BAV क्या है?",
  "avQHowToRead": "इन स्कोर को कैसे पढ़ें",
  "avQSavVsBav": "SAV बनाम BAV",
  "avABody": "अष्टकवर्ग वैदिक ज्योतिष में अंकों पर आधारित एक शक्ति प्रणाली है। प्रत्येक ग्रह अपनी स्थिति के अनुसार बारह राशियों को शुभ अंक (बिंदु, जिन्हें रेखा भी कहते हैं) देता है। किसी राशि में जितने अधिक अंक होंगे, संबंधित ग्रह दशा और गोचर के दौरान जीवन का वह क्षेत्र उतना ही सहज सहयोग पाएगा।",
  "avSavBody": "SAV (सर्व अष्टकवर्ग) सातों ग्रहों के अंकों को प्रत्येक राशि के लिए जोड़ता है। यह प्रत्येक राशि के लिए एक ही शक्ति स्कोर देता है, जिससे आप जल्दी देख सकते हैं कि आपकी कुंडली में कौन-सी राशियाँ — और उनके भाव — सबसे अधिक सहयोग प्राप्त कर रहे हैं।",
  "avBavBody": "BAV (भिन्न अष्टकवर्ग) एक ही ग्रह के अंक बारह राशियों में दिखाता है। यह बताता है कि कोई विशेष ग्रह किन राशियों को सबसे अधिक सहयोग देता है, जो तब महत्वपूर्ण होता है जब उस ग्रह की दशा या गोचर सक्रिय हो।",
  "avHowToReadBody": "अधिक अंक बेहतर माने जाते हैं। SAV के लिए, औसत राशि लगभग 28 अंक पाती है — 30 से ऊपर मजबूत और 25 से नीचे सावधानी की आवश्यकता दर्शाता है। BAV के लिए, प्रत्येक राशि 0 से 8 के बीच होती है, जिसमें 4 औसत माना जाता है। महत्वपूर्ण कार्यों के लिए अपनी सबसे मजबूत राशियों को प्राथमिकता दें, और सबसे कमजोर राशियों के मामलों में धैर्य और अनुशासन बनाए रखें।",
  "avSavVsBavBody": "SAV सभी ग्रहों का संयुक्त कुल है और किसी राशि की समग्र शक्ति दिखाता है। BAV एक ही ग्रह का योगदान है और बताता है कि कौन-सा ग्रह उस राशि को सहयोग देता है। बड़ी तस्वीर समझने के लिए SAV का उपयोग करें, और यह जानने के लिए कि किस ग्रह से राशि की शक्ति आती है, BAV देखें।",
  "avSummaryInsight": "आपकी कुंडली {s1}, {s2} और {s3} में सबसे मजबूत है। ये राशियाँ ग्रह दशाओं और गोचर के दौरान बेहतर सहयोग देती हैं। {weak} में फिलहाल सबसे कम सहयोग है, इसलिए इससे जुड़े मामलों में धैर्य और अनुशासन मददगार रहेगा।",
  "avBavInsight": "{planet} {s1} और {s2} के माध्यम से सबसे अधिक प्रभावी रहता है। जब ये राशियाँ सक्रिय होती हैं, तो {planet} से संबंधित मामलों में सुधार होता है।",
  "avInsightStrong": "आपकी सबसे मजबूत राशियाँ {s1} और {s2} हैं — जब ग्रह इनसे गोचर करें तो महत्वपूर्ण शुरुआत के लिए इन्हें प्राथमिकता दें।",
  "avInsightWeak": "{s1} में सबसे कम सहयोग है — इससे जुड़े मामलों में सावधानी बरतें और अधिक प्रतिबद्धता से बचें।",
  "avInsightBestPlanet": "{planet} के पास सबसे अधिक अंक हैं, इसलिए इससे जुड़े विषय आपके जीवन में अच्छी तरह सहयोग पाते हैं।",
  "avInsightWeakPlanet": "{planet} के पास सबसे कम अंक हैं और यह उपायों तथा सजग प्रयास से सबसे अधिक लाभान्वित होता है।",
  "avInsightAverage": "जिन राशियों का स्कोर आपके औसत {avg} अंकों से अधिक है, वे आमतौर पर अधिक सहज और भरोसेमंद परिणाम देती हैं।",
