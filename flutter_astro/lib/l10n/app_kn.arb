  "avQWhatIsBav": "BAV ಎಂದರೇನು?",
  "avQHowToRead": "ಈ ಸ್ಕೋರ್‌ಗಳನ್ನು ಹೇಗೆ ಓದುವುದು",
  "avQSavVsBav": "SAV vs BAV",
  "avABody": "ಅಷ್ಟಕವರ್ಗವು ವೈದಿಕ ಜ್ಯೋತಿಷ್ಯದಲ್ಲಿ ಅಂಕಗಳ ಆಧಾರಿತ ಶಕ್ತಿ ವ್ಯವಸ್ಥೆಯಾಗಿದೆ. ಪ್ರತಿ ಗ್ರಹವು ತನ್ನ ಸ್ಥಾನವನ್ನು ಅವಲಂಬಿಸಿ ಹನ್ನೆರಡು ರಾಶಿಗಳಿಗೆ ಶುಭ ಅಂಕಗಳನ್ನು (ಬಿಂದುಗಳು, ಇವನ್ನು ರೇಖೆಗಳು ಎಂದೂ ಕರೆಯುತ್ತಾರೆ) ನೀಡುತ್ತದೆ. ಒಂದು ರಾಶಿಯಲ್ಲಿ ಹೆಚ್ಚು ಅಂಕಗಳಿದ್ದರೆ, ಸಂಬಂಧಿತ ಗ್ರಹ ದಶೆ ಮತ್ತು ಗೋಚಾರದ ಸಮಯದಲ್ಲಿ ಜೀವನದ ಆ ಕ್ಷೇತ್ರವು ಹೆಚ್ಚು ಸುಗಮ ಬೆಂಬಲ ಪಡೆಯುತ್ತದೆ.",
  "avSavBody": "SAV (ಸರ್ವ ಅಷ್ಟಕವರ್ಗ) ಪ್ರತಿ ರಾಶಿಗೆ ಎಲ್ಲಾ ಏಳು ಗ್ರಹಗಳ ಅಂಕಗಳನ್ನು ಒಟ್ಟುಗೂಡಿಸುತ್ತದೆ. ಇದು ಪ್ರತಿ ರಾಶಿಗೆ ಒಂದೇ ಶಕ್ತಿ ಸ್ಕೋರ್ ನೀಡುತ್ತದೆ, ಇದರಿಂದ ನಿಮ್ಮ ಜಾತಕದಲ್ಲಿ ಯಾವ ರಾಶಿಗಳು — ಮತ್ತು ಅವು ಬೀಳುವ ಭಾವಗಳು — ಹೆಚ್ಚು ಬೆಂಬಲಿತವಾಗಿವೆ ಎಂಬುದನ್ನು ನೀವು ಬೇಗ ನೋಡಬಹುದು.",
  "avBavBody": "BAV (ಭಿನ್ನ ಅಷ್ಟಕವರ್ಗ) ಒಂದೇ ಗ್ರಹದ ಅಂಕಗಳನ್ನು ಹನ್ನೆರಡು ರಾಶಿಗಳಲ್ಲಿ ತೋರಿಸುತ್ತದೆ. ಒಂದು ನಿರ್ದಿಷ್ಟ ಗ್ರಹ ಯಾವ ರಾಶಿಗಳಿಗೆ ಹೆಚ್ಚು ಬೆಂಬಲ ನೀಡುತ್ತದೆ ಎಂಬುದನ್ನು ಇದು ತಿಳಿಸುತ್ತದೆ, ಆ ಗ್ರಹದ ದಶೆ ಅಥವಾ ಗೋಚಾರ ಸಕ್ರಿಯವಾದಾಗ ಇದು ಮುಖ್ಯವಾಗುತ್ತದೆ.",
  "avHowToReadBody": "ಹೆಚ್ಚಿನ ಸಂಖ್ಯೆಗಳು ಉತ್ತಮ. SAV ಗಾಗಿ, ಸರಾಸರಿ ರಾಶಿ ಸುಮಾರು 28 ಅಂಕಗಳನ್ನು ಪಡೆಯುತ್ತದೆ — 30ಕ್ಕಿಂತ ಹೆಚ್ಚು ಬಲಿಷ್ಠ ಮತ್ತು 25ಕ್ಕಿಂತ ಕಡಿಮೆ ಎಚ್ಚರಿಕೆ ಬೇಕು. BAV ಗಾಗಿ, ಪ್ರತಿ ರಾಶಿ 0 ರಿಂದ 8ರ ನಡುವೆ ಇರುತ್ತದೆ, 4 ಅನ್ನು ಸರಾಸರಿ ಎಂದು ಪರಿಗಣಿಸಲಾಗುತ್ತದೆ. ಮುಖ್ಯ ಕಾರ್ಯಗಳಿಗೆ ನಿಮ್ಮ ಬಲಿಷ್ಠ ರಾಶಿಗಳಿಗೆ ಆದ್ಯತೆ ನೀಡಿ, ಮತ್ತು ನಿಮ್ಮ ದುರ್ಬಲ ರಾಶಿಗಳ ವಿಷಯಗಳಲ್ಲಿ ತಾಳ್ಮೆ ಮತ್ತು ಶಿಸ್ತು ಕಾಪಾಡಿಕೊಳ್ಳಿ.",
  "avSavVsBavBody": "SAV ಎಲ್ಲಾ ಗ್ರಹಗಳ ಒಟ್ಟುಗೂಡಿದ ಮೊತ್ತವಾಗಿದ್ದು, ಇದು ಒಂದು ರಾಶಿಯ ಒಟ್ಟಾರೆ ಶಕ್ತಿಯನ್ನು ತೋರಿಸುತ್ತದೆ. BAV ಒಂದೇ ಗ್ರಹದ ಕೊಡುಗೆಯಾಗಿದ್ದು, ಯಾವ ಗ್ರಹ ಆ ರಾಶಿಗೆ ಬೆಂಬಲ ನೀಡುತ್ತದೆ ಎಂಬುದನ್ನು ತೋರಿಸುತ್ತದೆ. ದೊಡ್ಡ ಚಿತ್ರವನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು SAV ಬಳಸಿ, ಮತ್ತು ಯಾವ ಗ್ರಹ ರಾಶಿಯ ಶಕ್ತಿಯನ್ನು ಚಾಲನೆ ಮಾಡುತ್ತದೆ ಎಂಬುದನ್ನು ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು BAV ನೋಡಿ.",
  "avSummaryInsight": "ನಿಮ್ಮ ಜಾತಕ {s1}, {s2} ಮತ್ತು {s3} ರಾಶಿಗಳಲ್ಲಿ ಅತ್ಯಂತ ಬಲಿಷ್ಠವಾಗಿದೆ. ಈ ರಾಶಿಗಳು ಗ್ರಹ ದಶೆಗಳು ಮತ್ತು ಗೋಚಾರಗಳ ಸಮಯದಲ್ಲಿ ಉತ್ತಮ ಬೆಂಬಲ ನೀಡುತ್ತವೆ. {weak} ಪ್ರಸ್ತುತ ಅತ್ಯಂತ ಕಡಿಮೆ ಬೆಂಬಲ ಹೊಂದಿದೆ, ಆದ್ದರಿಂದ ಅದಕ್ಕೆ ಸಂಬಂಧಿಸಿದ ವಿಷಯಗಳಲ್ಲಿ ತಾಳ್ಮೆ ಮತ್ತು ಶಿಸ್ತು ಸಹಾಯಕವಾಗುತ್ತದೆ.",
  "avBavInsight": "{planet} {s1} ಮತ್ತು {s2} ಮೂಲಕ ಅತ್ಯಂತ ಬಲಿಷ್ಠವಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ. ಈ ರಾಶಿಗಳು ಸಕ್ರಿಯವಾದಾಗ {planet} ನಿಯಂತ್ರಿಸುವ ವಿಷಯಗಳು ಸುಧಾರಿಸುತ್ತವೆ.",
  "avInsightStrong": "ನಿಮ್ಮ ಬಲಿಷ್ಠ ರಾಶಿಗಳು {s1} ಮತ್ತು {s2} — ಗ್ರಹಗಳು ಇವುಗಳ ಮೂಲಕ ಗೋಚರಿಸಿದಾಗ ಮುಖ್ಯ ಆರಂಭಗಳಿಗೆ ಇವುಗಳಿಗೆ ಆದ್ಯತೆ ನೀಡಿ.",
  "avInsightWeak": "{s1} ಅತ್ಯಂತ ಕಡಿಮೆ ಬೆಂಬಲ ಹೊಂದಿದೆ — ಅದರ ವಿಷಯಗಳಲ್ಲಿ ಎಚ್ಚರಿಕೆಯಿಂದ ಮುಂದುವರಿಯಿರಿ ಮತ್ತು ಅತಿಯಾದ ಬದ್ಧತೆಯನ್ನು ತಪ್ಪಿಸಿ.",
  "avInsightBestPlanet": "{planet} ಅತಿ ಹೆಚ್ಚು ಅಂಕಗಳನ್ನು ಹೊಂದಿದೆ, ಆದ್ದರಿಂದ ಅದರ ಸೂಚನೆಗಳು ನಿಮ್ಮ ಜೀವನದಲ್ಲಿ ಉತ್ತಮವಾಗಿ ಬೆಂಬಲಿತವಾಗಿವೆ.",
  "avInsightWeakPlanet": "{planet} ಅತ್ಯಂತ ಕಡಿಮೆ ಅಂಕಗಳನ್ನು ಹೊಂದಿದೆ ಮತ್ತು ಪರಿಹಾರಗಳು ಹಾಗೂ ಪ್ರಜ್ಞಾಪೂರ್ವಕ ಪ್ರಯತ್ನದಿಂದ ಹೆಚ್ಚು ಪ್ರಯೋಜನ ಪಡೆಯುತ್ತದೆ.",
  "avInsightAverage": "ನಿಮ್ಮ ಸರಾಸರಿ {avg} ಅಂಕಗಳಿಗಿಂತ ಹೆಚ್ಚು ಸ್ಕೋರ್ ಮಾಡುವ ರಾಶಿಗಳು ಸಾಮಾನ್ಯವಾಗಿ ಹೆಚ್ಚು ಸುಗಮ ಮತ್ತು ವಿಶ್ವಾಸಾರ್ಹ ಫಲಿತಾಂಶಗಳನ್ನು ನೀಡುತ್ತವೆ.",
